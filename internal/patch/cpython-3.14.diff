ceval.c: ccgo rejects the nested designated union-member initializer
`{ .op.code = X, .op.arg = Y }` of _Py_CODEUNIT ("too many items in
initializer"); `{ .op = { .code = X, .arg = Y } }` is accepted.
diff --color -ruN a/Python/ceval.c b/Python/ceval.c
--- a/Python/ceval.c	2026-09-04 23:04:22
+++ b/Python/ceval.c	2026-09-04 23:05:40
@@ -1050,11 +1050,11 @@
 static const _Py_CODEUNIT _Py_INTERPRETER_TRAMPOLINE_INSTRUCTIONS[] = {
     /* Put a NOP at the start, so that the IP points into
     * the code, rather than before it */
-    { .op.code = NOP, .op.arg = 0 },
-    { .op.code = INTERPRETER_EXIT, .op.arg = 0 },  /* reached on return */
-    { .op.code = NOP, .op.arg = 0 },
-    { .op.code = INTERPRETER_EXIT, .op.arg = 0 },  /* reached on yield */
-    { .op.code = RESUME, .op.arg = RESUME_OPARG_DEPTH1_MASK | RESUME_AT_FUNC_START }
+    { .op = { .code = NOP, .arg = 0 } },
+    { .op = { .code = INTERPRETER_EXIT, .arg = 0 } },  /* reached on return */
+    { .op = { .code = NOP, .arg = 0 } },
+    { .op = { .code = INTERPRETER_EXIT, .arg = 0 } },  /* reached on yield */
+    { .op = { .code = RESUME, .arg = RESUME_OPARG_DEPTH1_MASK | RESUME_AT_FUNC_START } }
 };
 
